isbngeneratorservice_test_suite:
    fixture:
        isbn_generator = IsbnGeneratorService()
    next_test_suite:
        isbn_is_generated:
            isbn = isbn_generator.next()
            assert_notnull(isbn)
        generated_isbn_has_prefix:
            prefix = 'ISBN-'
            isbn = isbn_generator.next()
            assert_true(isbn.starts_with(prefix))
        generated_isbn_has_2_hyphens:
            isbn = isbn_generator.next()
            splitted = isbn.split('-')
            assert_equal(3, splitted.length)
        generated_isbn_has_country_code:
            isbn = isbn_generator.next()
            splitted = isbn.split('-')
            country_code = splitted[2]
            assert_equals(2, country_code.length)
        generated_isbns_are_unique:
            isbn1 = isbn_generator.next()
            isbn2 = isbn_generator.next()
            assert_not_equal(isbn1, isbn2)